<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RECORD_AUDIO здесь нет и не будет. Приложение не записывает звук:
         запись создаёт штатный Huawei Phone/Recorder или выбранный владельцем
         сторонний рекордер, мы подбираем готовый файл (ТЗ §6, спека 3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- до 33 медиатеку открывало общее чтение хранилища, с 33 — отдельное на аудио -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- SMS читаем из провайдера (ТЗ §14), SMS-приложением по умолчанию не
         становимся. Откажет прошивка — те же уведомления, что для WhatsApp. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- http без TLS: сервер виден только из домашней локалки, а без этого
         флага с targetSdk 28+ любой запрос падает исключением ещё до сети -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- после перезагрузки расписание надо ставить заново -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp без root читается только отсюда (ТЗ §13); из уведомления
             берутся только поля §5.1C. Доступ включает владелец в системном
             списке — это не runtime-разрешение. -->
        <service
            android:name=".MessageListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- разговор кончился — через минуту смотрим папку, а не ждём сверки -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
